<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyTitle>Unblock Discord Automatic Service</AssemblyTitle>
    <Product>Unblock Discord</Product>
    <Description>Event-driven Discord-only bypass Windows service.</Description>
    <Version>0.1.0</Version>
    <ApplicationIcon>..\assets\unblock-discord.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
    <Compile Include="..\BypassController.cs" Link="Shared\BypassController.cs" />
    <Compile Include="..\ChildProcesses.cs" Link="Shared\ChildProcesses.cs" />
    <Compile Include="..\DiscordRelay.cs" Link="Shared\DiscordRelay.cs" />
    <Compile Include="..\DiscordTraffic.cs" Link="Shared\DiscordTraffic.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\engines\**\*" Link="engines\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Install-Automatic-Service.bat;..\Remove-Automatic-Service.bat;..\Check-Automatic-System.bat" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\tools\Install-Service.ps1;..\tools\Install-Service-Launcher.ps1;..\tools\Uninstall-Service.ps1;..\tools\Remove-Service-Launcher.ps1;..\tools\Check-Automatic-System.ps1" Link="tools\%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\docs\SERVICE.md" Link="README.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
