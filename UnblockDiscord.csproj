<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\unblock-discord.ico</ApplicationIcon>
    <Title>Unblock Discord</Title>
    <AssemblyTitle>Unblock Discord</AssemblyTitle>
    <Product>Unblock Discord</Product>
    <Description>Discord-only DPI bypass for Windows in Turkey, using ByeDPI and ProxiFyre with per-connection DNS correction.</Description>
    <Authors>alperenkaptan</Authors>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/alperenkaptan/UnblockDiscord</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/alperenkaptan/UnblockDiscord</PackageProjectUrl>
    <PackageTags>discord;turkey;turkiye;dpi-bypass;byedpi;proxifyre;windows;winforms</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**;service\**" />
    <Content Include="engines\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="UnblockDiscord.Tests" />
    <EmbeddedResource Include="assets\unblock-discord.ico" LogicalName="UnblockDiscord.AppIcon" />
    <None Update="README.md;docs\TECHNICAL.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Remove-Automatic-Service.bat;tools\Remove-Service-Launcher.ps1;Install-Automatic-Service.bat;tools\Install-Service-Launcher.ps1;docs\SERVICE.md;tools\Install-Service.ps1;tools\Uninstall-Service.ps1" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishAutomaticService" AfterTargets="Publish">
    <MSBuild Projects="service\UnblockDiscord.Service.csproj" Targets="Restore;Publish" RemoveProperties="PublishProfile;PublishProfileFullPath"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=false;PublishTrimmed=false;PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'));DebugType=none;DebugSymbols=false" />
  </Target>
</Project>
