<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\unblock-discord.ico</ApplicationIcon>
    <Title>Unblock Discord</Title>
    <AssemblyTitle>Unblock Discord</AssemblyTitle>
    <Product>Unblock Discord</Product>
    <Description>Discord-only DPI bypass for Windows in Turkey, using ByeDPI and ProxiFyre with per-connection DNS correction.</Description>
    <Authors>alperenkaptan</Authors>
    <Version>0.1.0</Version>
    <RepositoryUrl>https://github.com/alperenkaptan/UnblockDiscord</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/alperenkaptan/UnblockDiscord</PackageProjectUrl>
    <PackageTags>discord;turkey;turkiye;dpi-bypass;byedpi;proxifyre;windows;winforms</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**;service\**" />
    <Content Include="engines\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="UnblockDiscord.Tests" />
    <EmbeddedResource Include="assets\unblock-discord.ico" LogicalName="UnblockDiscord.AppIcon" />
    <None Update="README.md;docs\TECHNICAL.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update="docs\SERVICE.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PublishAutomaticService" AfterTargets="Publish">
    <PropertyGroup>
      <_ManualPublishDirectory>$([System.IO.Path]::GetFullPath('$(PublishDir)', '$(MSBuildProjectDirectory)'))</_ManualPublishDirectory>
      <_ModePublishRoot>$([System.IO.Path]::GetFullPath('..', '$(_ManualPublishDirectory)'))</_ModePublishRoot>
      <_ServicePublishDirectory>$([System.IO.Path]::Combine('$(_ModePublishRoot)', 'Automatic-Service'))</_ServicePublishDirectory>
    </PropertyGroup>
    <MSBuild Projects="service\UnblockDiscord.Service.csproj" Targets="Restore;Publish" RemoveProperties="PublishProfile;PublishProfileFullPath"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=false;PublishTrimmed=false;PublishDir=$(_ServicePublishDirectory)\;DebugType=none;DebugSymbols=false" />
    <WriteLinesToFile File="$(_ModePublishRoot)\README.txt" Overwrite="true"
                      Lines="Unblock Discord - Windows x64;Manual mode: run Manual\UnblockDiscord.exe and click Start.;Automatic mode: open Automatic-Service and run Install-Automatic-Service.bat.;Status: Automatic-Service\Check-Automatic-System.bat waits for you to close it.;Removal: Automatic-Service\Remove-Automatic-Service.bat.;Use one mode at a time. Each folder contains its own runtime and engines.;See Automatic-Service\README.md for installation details." />
  </Target>
</Project>
